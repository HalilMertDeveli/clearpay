        </StmtSimple>
        <StmtSimple StatementText="WITH page AS&#xA;    (&#xA;        SELECT e.Id, e.CreatedAt, e.Kind, e.Amount, e.CorrelationId, e.PairId&#xA;        FROM dbo.LedgerEntry AS e&#xA;        WHERE e.WalletId = @WalletId&#xA;          AND (@From IS NULL OR e.CreatedAt &gt;= @From)&#xA;          AND (@To   IS NULL OR e.CreatedAt &lt;  @To)&#xA;          AND (@Kind IS NULL OR e.Kind = @Kind)&#xA;        ORDER BY e.CreatedAt DESC, e.Id DESC&#xA;        OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY&#xA;    )&#xA;    SELECT&#xA;        p.Id,&#xA;        p.CreatedAt,&#xA;        p.Kind,&#xA;        p.Amount,&#xA;        p.CorrelationId,&#xA;        p.PairId,&#xA;        CounterpartyUserId = cw.UserId,&#xA;        TotalCount         = @Total&#xA;    FROM page AS p&#xA;    OUTER APPLY&#xA;    (&#xA;        SELECT TOP (1) c.WalletId&#xA;        FROM dbo.LedgerEntry AS c&#xA;        WHERE c.PairId = p.PairId&#xA;          AND c.WalletId &lt;&gt; @WalletId&#xA;    ) AS cp&#xA;    LEFT JOIN dbo.Wallet AS cw ON cw.Id = cp.WalletId&#xA;    ORDER BY p.CreatedAt DESC, p.Id DESC&#xA;    OPTION (RECOMPILE)" StatementId="2" StatementCompId="16" StatementType="SELECT" StatementSqlHandle="0x09001FFBC6FAD1C96A1CB1F035C186F3FE210000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1269579561" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="29.4932" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xFB824B4DE0539308" QueryPlanHash="0xE36BF877AA8850B4" CardinalityEstimationModelVersion="160">
          <StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false" />
