        </StmtSimple>
        <StmtSimple StatementText="WITH page AS&#xD;&#xA;    (&#xD;&#xA;        SELECT e.Id, e.CreatedAt, e.Kind, e.Amount, e.CorrelationId, e.PairId&#xD;&#xA;        FROM dbo.LedgerEntry AS e&#xD;&#xA;        WHERE e.WalletId = @WalletId&#xD;&#xA;          AND (@From IS NULL OR e.CreatedAt &gt;= @From)&#xD;&#xA;          AND (@To   IS NULL OR e.CreatedAt &lt;  @To)&#xD;&#xA;          AND (@Kind IS NULL OR e.Kind = @Kind)&#xD;&#xA;        ORDER BY e.CreatedAt DESC, e.Id DESC&#xD;&#xA;        OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY&#xD;&#xA;    )&#xD;&#xA;    SELECT&#xD;&#xA;        p.Id,&#xD;&#xA;        p.CreatedAt,&#xD;&#xA;        p.Kind,&#xD;&#xA;        p.Amount,&#xD;&#xA;        p.CorrelationId,&#xD;&#xA;        p.PairId,&#xD;&#xA;        CounterpartyUserId = cw.UserId,&#xD;&#xA;        TotalCount         = @Total&#xD;&#xA;    FROM page AS p&#xD;&#xA;    OUTER APPLY&#xD;&#xA;    (&#xD;&#xA;        SELECT TOP (1) c.WalletId&#xD;&#xA;        FROM dbo.LedgerEntry AS c&#xD;&#xA;        WHERE c.PairId = p.PairId&#xD;&#xA;          AND c.WalletId &lt;&gt; @WalletId&#xD;&#xA;    ) AS cp&#xD;&#xA;    LEFT JOIN dbo.Wallet AS cw ON cw.Id = cp.WalletId&#xD;&#xA;    ORDER BY p.CreatedAt DESC, p.Id DESC&#xD;&#xA;    OPTION (RECOMPILE)" StatementId="2" StatementCompId="16" StatementType="SELECT" StatementSqlHandle="0x09005FF0AF0FCA0BB653E8EEDE4BD93A09890000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="1269579561" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="0.0482488" StatementEstRows="20" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xFB824B4DE0539308" QueryPlanHash="0xCA689822E460396C" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160">
