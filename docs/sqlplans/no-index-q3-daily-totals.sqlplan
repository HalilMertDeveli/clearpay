      <Statements>
        <StmtSimple StatementText="SELECT&#xA;        e.Kind,&#xA;        EntryCount  = COUNT_BIG(*),&#xA;        CreditTotal = ISNULL(SUM(CASE WHEN e.Amount &gt; 0 THEN e.Amount END), 0),&#xA;        DebitTotal  = ISNULL(SUM(CASE WHEN e.Amount &lt; 0 THEN -e.Amount END), 0),&#xA;        Net         = SUM(e.Amount)&#xA;    FROM dbo.LedgerEntry AS e&#xA;    WHERE e.CreatedAt &gt;= @DayStart&#xA;      AND e.CreatedAt &lt;  @DayEnd&#xA;    GROUP BY e.Kind&#xA;    ORDER BY e.Kind" StatementId="1" StatementCompId="6" StatementType="SELECT" StatementSqlHandle="0x090091127D691186964F3349FDCF7747B1FA0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1253579504" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="7.69317" StatementEstRows="3" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xAF29984D4E9C61FC" QueryPlanHash="0x0F8DCD9624548F5F" CardinalityEstimationModelVersion="160">
