<Project Sdk="Microsoft.NET.Sdk">

  <!-- Message contracts shared by the web app (producer) and the worker services (consumers).
       No package or project references on purpose: a consumer can take this assembly without pulling in EF, Identity or RabbitMQ. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
