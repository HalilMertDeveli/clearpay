<Project Sdk="Microsoft.NET.Sdk">

  <!-- RabbitMQ plumbing shared by the web app and the worker services:
       topology (topic exchange, work / retry / dead-letter queues), a publisher with confirms,
       a consumer host with retry + DLQ, the consumer idempotency table and W3C trace headers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.21" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearPay.Contracts\ClearPay.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClearPay.Services.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
