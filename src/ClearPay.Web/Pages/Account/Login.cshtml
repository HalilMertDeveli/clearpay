@page
@model ClearPay.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["SignIn"].Value;
    ViewData["MetaDescription"] = L["MetaSignIn"].Value;
}

<h1 class="page-title">@L["SignIn"]</h1>
<p class="lede">@L["SignInLede"]</p>
<form method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="auth-tabset">
        <nav class="auth-tabs" aria-label="@L["SignIn"]">
            <a href="#eposta">@L["SignInTabEmail"]</a>
            <a href="#tc">@L["SignInTabTc"]</a>
        </nav>
        <div id="eposta" class="auth-panel">
            <div class="field">
                <label asp-for="Input.Email" class="field-label">@L["Email"]</label>
                <input asp-for="Input.Email" class="field-input" type="email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
        </div>
        <div id="tc" class="auth-panel">
            <div class="field">
                <label asp-for="Input.Tc" class="field-label">@L["SignInTabTc"]</label>
                <input asp-for="Input.Tc" class="field-input" inputmode="numeric" autocomplete="off" />
                <span asp-validation-for="Input.Tc" class="field-error"></span>
                <p class="field-hint">@L["SignInTcHint"]</p>
            </div>
        </div>
    </div>
    <div class="field">
        <label asp-for="Input.Password" class="field-label">@L["Password"]</label>
        <input asp-for="Input.Password" class="field-input" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>
    <div class="field field-check">
        <label class="check-label" asp-for="Input.RememberMe">
            <input asp-for="Input.RememberMe" />
            <span>@L["RememberMe"]</span>
        </label>
    </div>
    <button type="submit" class="btn btn-block">@L["SignIn"]</button>
</form>
<partial name="_ExternalLoginButtons" model="Model.ReturnUrl" />
<p class="auth-switch">@L["NoAccount"] <a asp-page="/Account/Register">@L["CreateAccount"]</a></p>
@section Scripts {
    <script>
        (() => {
            const form = document.querySelector(".auth-form");
            if (!form) return;
            form.addEventListener("submit", () => {
                const useTc = location.hash === "#tc";
                const email = form.querySelector('[name="Input.Email"]');
                const tc = form.querySelector('[name="Input.Tc"]');
                if (email) email.disabled = useTc;
                if (tc) tc.disabled = !useTc;
            });
        })();
    </script>
}
