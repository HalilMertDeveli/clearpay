@page "/hareketler"
@model HareketlerModel
@{
    ViewData["Title"] = L["Activity"].Value;
    ViewData["MetaDescription"] = L["MetaActivity"].Value;
    ViewData["Wide"] = true;
}

<p class="page-kicker">@L["HistoryKicker"]</p>
<h1 class="page-title">@L["Activity"]</h1>
<p class="lede">@L["ActivityLede"]</p>

<section class="panel">
    <form method="get" class="stack-form filter-bar" novalidate>
        <div class="filter-row">
            <div class="field">
                <label class="field-label" for="baslangic">@L["FilterFrom"]</label>
                <input class="field-input" id="baslangic" name="Baslangic" type="date" value="@(Model.Baslangic?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field">
                <label class="field-label" for="bitis">@L["FilterTo"]</label>
                <input class="field-input" id="bitis" name="Bitis" type="date" value="@(Model.Bitis?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="field">
                <label class="field-label" for="tur">@L["FilterType"]</label>
                <select class="field-input" id="tur" name="Tur">
                    <option value="">@L["FilterAll"]</option>
                    <option value="Transfer" selected="@(Model.Tur == "Transfer" ? "selected" : null)">@L["NavTransfer"]</option>
                    <option value="TopUp" selected="@(Model.Tur == "TopUp" ? "selected" : null)">@L["TopUp"]</option>
                    <option value="Withdraw" selected="@(Model.Tur == "Withdraw" ? "selected" : null)">@L["Withdraw"]</option>
                </select>
            </div>
            <div class="field">
                <button type="submit" class="btn">@L["Filter"]</button>
            </div>
        </div>
    </form>
    <table class="data-table data-cards data-cards--tx">
        <thead>
            <tr>
                <th>@L["ColDate"]</th>
                <th>@L["ColRef"]</th>
                <th>@L["FilterType"]</th>
                <th>@L["ColCounterparty"]</th>
                <th class="num">@L["ColAmount"]</th>
                <th>@L["ColStatus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Result.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="empty-cell">
                        <div class="empty-block">
                            <div class="empty-mark" aria-hidden="true"></div>
                            <p class="empty-title">@L["EmptyPeriodTitle"]</p>
                            <p class="empty-hint">@L["EmptyPeriodHint"]</p>
                            <div class="empty-actions">
                                <a class="btn" asp-page="/Havale">@L["SendTransfer"]</a>
                                <a class="btn btn-ghost" asp-page="/YukleCek">@L["TopUp"]</a>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var row in Model.Result.Items)
                {
                    var corr = row.CorrelationId.ToString();
                    var shortCorr = row.CorrelationId.ToString("N").Substring(0, 8);
                    <tr>
                        <td>@row.At.ToLocalTime().ToString("g")</td>
                        <td>
                            <span class="receipt-ref">
                                <code class="mono" title="@corr">@shortCorr</code>
                                <button type="button"
                                        class="btn-text"
                                        data-copy="@corr"
                                        data-copied="@L["Copied"]">@L["CopyRef"]</button>
                            </span>
                        </td>
                        <td>@row.Kind</td>
                        <td>@row.Counterparty</td>
                        <td class="num @(row.SignedAmount > 0m ? "amount-in" : null)">@ClearPay.Web.Presentation.MoneyDisplay.FormatTry(row.SignedAmount)</td>
                        <td>@L["StatusCompleted"]</td>
                        <td><a class="text-link" asp-page="/Dekont" asp-route-correlationId="@row.CorrelationId">@L["Receipt"]</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (Model.Result.TotalCount > Model.Result.PageSize)
    {
        <p class="field-hint">
            @if (Model.Result.Page > 1)
            {
                <a class="text-link" asp-page="/Hareketler" asp-route-Baslangic="@Model.Baslangic?.ToString("yyyy-MM-dd")" asp-route-Bitis="@Model.Bitis?.ToString("yyyy-MM-dd")" asp-route-Tur="@Model.Tur" asp-route-Sayfa="@(Model.Result.Page - 1)">←</a>
            }
            @Model.Result.Page
            @if (Model.Result.Page * Model.Result.PageSize < Model.Result.TotalCount)
            {
                <a class="text-link" asp-page="/Hareketler" asp-route-Baslangic="@Model.Baslangic?.ToString("yyyy-MM-dd")" asp-route-Bitis="@Model.Bitis?.ToString("yyyy-MM-dd")" asp-route-Tur="@Model.Tur" asp-route-Sayfa="@(Model.Result.Page + 1)">→</a>
            }
        </p>
    }
</section>
