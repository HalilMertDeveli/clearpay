@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="page-title">Bir hata oluştu</h1>
<section class="panel">
    @if (Model.ShowRequestId)
    {
        <p class="empty">İstek no: <code>@Model.RequestId</code></p>
    }
    <div class="actions">
        <a class="btn" asp-page="/Index">Cüzdana dön</a>
    </div>
</section>
