@page "/havale"
@model HavaleModel
@{
    ViewData["Title"] = L["Transfer"].Value;
    ViewData["MetaDescription"] = L["MetaTransfer"].Value;
}

<p class="page-kicker">@L["TransferKicker"]</p>
<h1 class="page-title">@L["Transfer"]</h1>
<p class="lede">@L["TransferLede"]</p>

<section class="panel">
    <form method="post" class="stack-form" novalidate>
        <div class="remain">
            <span class="stat-label">@L["RemainingBalance"]</span>
            <strong>@Html.Raw(Model.RemainingBalance)</strong>
        </div>
        <div class="field">
            <label class="field-label" for="alici">@L["RecipientEmail"]</label>
            <input class="field-input" id="alici" name="alici" type="email" autocomplete="off" />
        </div>
        <div class="field-row">
            <div class="field">
                <label class="field-label" for="tutar">@L["AmountTry"]</label>
                <input class="field-input" id="tutar" name="tutar" inputmode="decimal" />
            </div>
            <div class="field">
                <label class="field-label" for="aciklama">@L["Description"]</label>
                <input class="field-input" id="aciklama" name="aciklama" maxlength="140" />
            </div>
        </div>
        <p class="field-hint">@string.Format(L["TransferHint"].Value, ClearPay.Web.Presentation.MoneyDisplay.FormatTry(0m)) @L["DemoDisclaimer"]</p>
        <div class="form-actions">
            <button type="submit" class="btn" disabled>@L["Send"]</button>
            <a class="btn btn-ghost" asp-page="/Index">@L["Cancel"]</a>
        </div>
    </form>
</section>
