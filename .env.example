# Local Docker / demo engines only. Do not use in Azure.
# Copy to .env (gitignored).
MSSQL_SA_PASSWORD=ClearPay_Dev1!
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SQL Server (existing docker-compose.yml service sql, or Windows native)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa

# MySQL 8 (docker-compose.databases.yml)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=ClearPay_Dev1!
MYSQL_DATABASE=ClearPay

# Oracle XE (docker-compose.databases.yml) — gvenzl/oracle-xe, PDB XEPDB1
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_PASSWORD=ClearPay_Dev1!
ORACLE_APP_USER=clearpay
ORACLE_APP_USER_PASSWORD=ClearPay_Dev1!
ORACLE_SERVICE_NAME=XEPDB1