# Local Docker / demo engines only. Do not use in Azure.
# Copy to .env (gitignored). Real passwords live only in .env.
MSSQL_SA_PASSWORD=ClearPay_Dev1!
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SQL Server (docker-compose.yml service sql, data D:\ClearPay\data\mssql)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa

# MySQL 8 sidecar — app ledger stays MSSQL/LocalDB (T-021 / T-077). Not used by AddClearPay.
# This PC: Windows service MySQL84 (prefer when :3306 is taken). Compose: docker-compose.databases.yml
# (data D:\ClearPay\data\mysql). Placeholder = Compose default; copy to .env if native root differs.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=ClearPay_Dev1!
MYSQL_DATABASE=ClearPay

# Oracle XE (docker-compose.databases.yml, data D:\ClearPay\data\oracle) — gvenzl/oracle-xe, PDB XEPDB1
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_PASSWORD=CHANGE_ME_LOCAL_ONLY
ORACLE_APP_USER=clearpay
ORACLE_APP_USER_PASSWORD=CHANGE_ME_LOCAL_ONLY
ORACLE_SERVICE_NAME=XEPDB1
